<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="28dp"> <!-- Đã tăng khoảng cách phía trên để không bị sát đỉnh màn hình, tránh camera/status bar -->

    <TextView
        android:id="@+id/tvTenSuKienChi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hoạt động Thu Chi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1E88E5"
        tools:ignore="HardcodedText,VisualLintSystemUi" />

    <TextView
        android:id="@+id/tvQuyHienTaiChi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quỹ hiện có: 0 VNĐ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#388E3C"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnThemHoatDongChi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50"
        android:text="+ Thêm khoản chi mới"
        android:textColor="#FFFFFF"
        tools:ignore="HardcodedText,TextContrastCheck,VisualLintButtonSize" />

    <!-- RecyclerView chiếm phần không gian ở giữa -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDanhSachHoatDongChi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp" />

    <!-- Khu vực dưới cùng: Nút Back nằm ở góc trái, nhích lên 16dp đồng bộ với các màn hình khác -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_arrow_back"
            tools:ignore="TouchTargetSizeCheck,HardcodedText" />

    </LinearLayout>

</LinearLayout>