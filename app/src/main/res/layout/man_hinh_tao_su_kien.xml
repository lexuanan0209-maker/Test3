<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TẠO SỰ KIỆN MỚI"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1E88E5"
        android:layout_marginBottom="24dp"
        tools:ignore="HardcodedText" />

    <EditText
        android:id="@+id/etTenSuKienMoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Nhập tên sự kiện"
        android:inputType="text"
        android:padding="12dp"
        tools:ignore="Autofill,HardcodedText,TextContrastCheck,TextFields,VisualLintTextFieldSize" />

    <EditText
        android:id="@+id/etSoTienCanThuMoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Số tiền cần thu (ký tự số)"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        android:padding="12dp"
        tools:ignore="Autofill,HardcodedText,VisualLintTextFieldSize" />

    <TextView
        android:id="@+id/tvThoiGianTaoTuDong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thời gian tạo: [Hệ thống tự động lấy]"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginBottom="24dp"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnXacNhanTaoSuKien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#1E88E5"
        android:text="TẠO SỰ KIỆN"
        android:textColor="#FFFFFF"
        tools:ignore="HardcodedText,TextContrastCheck,VisualLintButtonSize" />
</LinearLayout>