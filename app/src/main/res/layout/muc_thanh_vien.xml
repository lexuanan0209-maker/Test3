<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvMucTenThanhVien"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textColor="@android:color/black"
        tools:ignore="VisualLintSystemUi" />

    <CheckBox
        android:id="@+id/cbMucDongTien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="12dp"
        android:contentDescription="Trạng thái đóng tiền"
        tools:ignore="HardcodedText,VisualLintSystemUi" />

    <ImageView
        android:id="@+id/btnMucMenuThanhVien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Menu tùy chọn thành viên"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="9dp"
        android:src="@android:drawable/ic_menu_more"
        tools:ignore="HardcodedText,ImageContrastCheck" />

</LinearLayout>