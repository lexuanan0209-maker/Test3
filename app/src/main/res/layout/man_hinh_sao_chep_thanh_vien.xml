<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHỌN SỰ KIỆN ĐÍCH ĐỂ SAO CHÉP THÀNH VIÊN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1E88E5"
        android:layout_marginBottom="12dp"
        tools:ignore="HardcodedText,VisualLintSystemUi" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuKienDich"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnThoatSaoChep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#888888"
        android:text="THOÁT &amp; QUAY LẠI"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"
        tools:ignore="HardcodedText,TextContrastCheck,VisualLintButtonSize" />
</LinearLayout>